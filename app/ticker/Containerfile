ARG NODE_IMAGE=docker.io/library/node:24-alpine
FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /app
# No dependencies (D10, D13).
COPY package.json ticker.js lib.js ./
# uid 1000, gid 1000: reads the agent's token sink (0640, group 1000).
USER 1000:1000
EXPOSE 9100
HEALTHCHECK --interval=10s --timeout=4s --retries=6 --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:9100/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "ticker.js"]
